    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setupMocks.js"
    ],
    "testTimeout": 30000
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nolan910/FitTogether-CDA.git"
  },
  "author": "",
