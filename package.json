{
  "name": "fittogether-cda",
  "version": "1.0.0",
  "description": "API REST de FitTogether",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --runInBand",
    "cleanup:legacy": "node scripts/cleanup-legacy-fields.js"
  },
